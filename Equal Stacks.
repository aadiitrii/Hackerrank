#include <stdio.h>

int main(void) {
    int n1, n2, n3;
    if (scanf("%d %d %d", &n1, &n2, &n3) != 3) return 0;

    int h1[100000], h2[100000], h3[100000];
    int i;

    for (i = 0; i < n1; i++) scanf("%d", &h1[i]);
    for (i = 0; i < n2; i++) scanf("%d", &h2[i]);
    for (i = 0; i < n3; i++) scanf("%d", &h3[i]);

    long long s1 = 0, s2 = 0, s3 = 0;
    for (i = 0; i < n1; i++) s1 += h1[i];
    for (i = 0; i < n2; i++) s2 += h2[i];
    for (i = 0; i < n3; i++) s3 += h3[i];

    int t1 = 0, t2 = 0, t3 = 0;

    while (!(s1 == s2 && s2 == s3)) {
        if (t1 == n1 || t2 == n2 || t3 == n3) {
            printf("0\n");
            return 0;
        }
        if (s1 >= s2 && s1 >= s3) s1 -= h1[t1++];
        else if (s2 >= s1 && s2 >= s3) s2 -= h2[t2++];
        else s3 -= h3[t3++];
    }

    printf("%lld\n", s1);
    return 0;
}
